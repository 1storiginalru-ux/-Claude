# Образец имён. Значения ключей вводятся в защищённых настройках среды.
# Django не читает .env автоматически: переменные должны быть экспортированы процессу.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=0
VOC_HTTPS=0
VOC_WB_TOKEN=
VOC_YM_TOKEN=
VOC_AI_KEY=
# Только для вашего портала и OAuth-токена с доступом к tasks:
VOC_BITRIX_DOMAIN=
VOC_BITRIX_TOKEN=
VOC_BITRIX_OWNER_ID=
VOC_BITRIX_NAMESPACE=voice
