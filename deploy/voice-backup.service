[Unit]
Description=Voice PostgreSQL daily backup
After=postgresql.service

[Service]
Type=oneshot
User=voice
Group=voice
WorkingDirectory=/opt/voice
EnvironmentFile=/etc/voice/voice.env
ExecStart=/opt/voice/.venv/bin/python manage.py backup_db
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/voice
