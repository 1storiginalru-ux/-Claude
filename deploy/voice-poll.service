[Unit]
Description=Voice marketplace polling
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=voice
Group=voice
WorkingDirectory=/opt/voice
EnvironmentFile=/etc/voice/voice.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/voice/.venv/bin/python manage.py sync_channels --loop
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/voice

[Install]
WantedBy=multi-user.target
